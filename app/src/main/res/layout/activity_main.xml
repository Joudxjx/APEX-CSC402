
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#010E0C"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Logo Icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="55dp"
            android:text="◎"
            android:textColor="#0EDDA5"
            android:textSize="48sp"
            android:gravity="center"/>

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APEX"
            android:textColor="#0EDDA5"
            android:textSize="38sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginTop="8dp"/>

        <!-- Welcome -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to APEX"
            android:textColor="#DDFDF6"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dark glowing background"
            android:textColor="#9AB8B3"
            android:textSize="14sp"
            android:layout_marginTop="8dp"/>

        <!-- Email Input -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="42dp"
            android:background="@drawable/input_background"
            android:hint="Username or Email"
            android:textColor="#DDFDF6"
            android:textColorHint="#9AB8B3"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="16sp"
            android:singleLine="true"
            android:inputType="textEmailAddress"/>

        <!-- Password Input -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/input_background"
            android:hint="Password"
            android:textColor="#DDFDF6"
            android:textColorHint="#9AB8B3"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="16sp"
            android:singleLine="true"
            android:inputType="textPassword"/>

        <!-- Login Button -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/button_background"
            android:backgroundTint="@null"
            android:text="LOGIN"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="#010E0C"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <!-- Sign Up -->
        <TextView
            android:id="@+id/tvSignUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Don't have an account? Sign Up"
            android:textColor="#DDFDF6"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Social Login Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="45dp">

            <View
                android:layout_width="35dp"
                android:layout_height="1dp"
                android:background="#56736D"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Or Social Login  "
                android:textColor="#789B94"
                android:textSize="13sp"/>

            <View
                android:layout_width="35dp"
                android:layout_height="1dp"
                android:background="#56736D"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
