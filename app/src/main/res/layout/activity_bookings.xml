<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#010E0C"
    tools:context=".bookings.BookingsActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="22dp"
        android:background="#102B3B">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Tickets"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Main Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="25dp"
            android:paddingBottom="20dp">

            <!-- Upcoming Digital Ticket -->
            <LinearLayout
                android:id="@+id/upcomingTicketCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp"
                android:background="@drawable/bg_ticket_card">

                <TextView
                    android:id="@+id/tvMovieTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cosmic Horizon"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMovieGenre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Action · 2h 15m"
                    android:gravity="center"
                    android:textColor="#B9D3E1"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvMovieDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Date &amp; Time: 14:50 at 02:00 PM"
                    android:gravity="center"
                    android:textColor="#DDFDF6"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvMovieCinema"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Hall 4 · Seats P6, P9"
                    android:gravity="center"
                    android:textColor="#DDFDF6"
                    android:textSize="14sp" />

                <!-- QR Code -->
                <ImageView
                    android:id="@+id/ivQRCode"
                    android:layout_width="175dp"
                    android:layout_height="175dp"
                    android:layout_marginTop="25dp"
                    android:background="#FFFFFF"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Digital Ticket QR Code" />

                <!-- Dashed Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="25dp"
                    android:background="@drawable/bg_ticket_divider" />

                <!-- Booking ID -->
                <TextView
                    android:id="@+id/tvBookingId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="Booking ID: 40437775990056"
                    android:textColor="#DDFDF6"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- Past Bookings Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="14dp"
                android:text="Past Bookings"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Past Booking 1 -->
            <LinearLayout
                android:id="@+id/pastBooking1"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/bg_past_booking">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="🎬"
                    android:textSize="30sp"
                    android:background="#17394A" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cosmic Horizon"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Action · 2h 15m"
                        android:textColor="#A9C2CF"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#DDFDF6"
                    android:textSize="30sp" />

            </LinearLayout>

            <!-- Past Booking 2 -->
            <LinearLayout
                android:id="@+id/pastBooking2"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/bg_past_booking">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="🎬"
                    android:textSize="30sp"
                    android:background="#17394A" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cosmic Horizon"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Action · 2h 15m"
                        android:textColor="#A9C2CF"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#DDFDF6"
                    android:textSize="30sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="12dp">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textSize="28sp"
                android:textColor="#A9C2CF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="12sp"
                android:textColor="#A9C2CF" />

        </LinearLayout>

        <!-- Tickets (Selected) -->
        <LinearLayout
            android:id="@+id/navTickets"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▣"
                android:textSize="27sp"
                android:textColor="#0EDDA5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tickets"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#0EDDA5" />

        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♙"
                android:textSize="27sp"
                android:textColor="#A9C2CF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="12sp"
                android:textColor="#A9C2CF" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
